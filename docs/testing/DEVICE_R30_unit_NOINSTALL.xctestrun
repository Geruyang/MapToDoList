					<array>
						<string>com.waypoint.MapToDoTests</string>
						<string>com.waypoint.MapToDoUITests</string>
						<string>com.waypoint.maptodo</string>
					</array>
					<key>CommandLineArguments</key>
					<array/>
					<key>DefaultTestExecutionTimeAllowance</key>
					<integer>600</integer>
					<key>DiagnosticCollectionPolicy</key>
					<integer>1</integer>
					<key>EnvironmentVariables</key>
					<dict>
						<key>APP_DISTRIBUTOR_ID_OVERRIDE</key>
						<string>com.apple.AppStore</string>
						<key>DYLD_INSERT_LIBRARIES</key>
						<string>/usr/lib/libRPAC.dylib</string>
						<key>OS_ACTIVITY_DT_MODE</key>
						<string>YES</string>
						<key>PERFC_ENABLE_EXTENDED_DIAGNOSTIC_FORMAT</key>
						<string>1</string>
						<key>PERFC_ENABLE_PROFILE_MODE</key>
						<string>1</string>
						<key>PERFC_RESET_INSERT_LIBRARIES</key>
						<string>1</string>
						<key>PERFC_SUPPRESS_SYSTEM_REPORTS</key>
						<string>1</string>
						<key>SQLITE_ENABLE_THREAD_ASSERTIONS</key>
						<string>1</string>
						<key>TERM</key>
						<string>dumb</string>
					</dict>
					<key>InProcessParallelizationEnabled</key>
					<false/>
					<key>IsAppHostedTestBundle</key>
					<true/>
					<key>OnlyTestIdentifiers</key>
					<array>
						<string>AIReleaseGateTests</string>
						<string>SubscriptionConcurrencyTests</string>
						<string>SubscriptionTimeoutTests</string>
					</array>
					<key>ParallelizationEnabled</key>
					<false/>
					<key>ProductModuleName</key>
					<string>MapToDoTests</string>
					<key>RunOrder</key>
					<integer>0</integer>
					<key>SystemAttachmentLifetime</key>
					<string>keepAlways</string>
					<key>TestBundleDestinationRelativePath</key>
					<string>__TESTHOST__/PlugIns/MapToDoTests.xctest</string>
					<key>TestHostBundleIdentifier</key>
					<string>com.waypoint.maptodo</string>
					<key>TestLanguage</key>
					<string></string>
					<key>TestRegion</key>
					<string></string>
					<key>TestTimeoutsEnabled</key>
					<false/>
					<key>TestingEnvironmentVariables</key>
					<dict>
						<key>DYLD_INSERT_LIBRARIES</key>
						<string>/System/Developer/usr/lib/libXCTestBundleInject.dylib:/usr/lib/libMainThreadChecker.dylib:/usr/lib/libRPAC.dylib</string>
						<key>PERFC_SUPPRESS_SYSTEM_REPORTS</key>
						<string>1</string>
						<key>XCInjectBundleInto</key>
						<string>unused</string>
						<key>XCODE_SCHEME_NAME</key>
						<string>MapToDo</string>
